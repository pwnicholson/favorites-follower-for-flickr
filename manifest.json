{
  "manifest_version": 3,
  "name": "Follow Favorites for Flickr",
  "version": "0.1.0",
  "description": "Aggregate and view favorite photos from selected Flickr users.",
  "permissions": ["storage", "activeTab", "identity"],
  "host_permissions": [
    "https://api.flickr.com/*",
    "https://*.staticflickr.com/*",
    "https://*.flickr.com/*"
  ],
  "action": {},
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.flickr.com/people/*",
        "https://*.flickr.com/photos/*",
        "https://*.flickr.com/photos/*/favorites"
      ],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["feed/feed.html", "feed/*"],
      "matches": ["https://*.flickr.com/*", "http://*.flickr.com/*"]
    }
  ]
}
